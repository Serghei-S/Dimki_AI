      "items": {
        "$ref": "#/$defs/block"
      },
      "minItems": 1
    },
    "parcels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parcel"
      },
      "minItems": 1
    },
    "buildings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/building"
      },
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "minItems": 1
    },
    "destinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/destination"
      },
      "minItems": 1
    },
    "stopBays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stopBay"
      },
      "minItems": 1
    },
    "transitServices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transitService"
      },
      "minItems": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      },
      "minItems": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "minItems": 1
    }
  },
  "required": [
    "$schema",
    "metadata",
    "metricDefinitions",
    "profiles",
    "roads",
    "blocks",
    "parcels",
    "buildings",
    "nodes",
    "edges",
    "destinations",
