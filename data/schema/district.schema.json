        "costsAreSynthetic": {
          "const": true
        },
        "edgeTimeRule": {
          "type": "string",
          "minLength": 1
        },
        "aggregationRule": {
          "type": "string",
          "minLength": 1
        },
        "coverageRule": {
          "type": "string",
          "minLength": 1
        },
        "comparisonEpsilonSeconds": {
          "type": "number",
          "minimum": 0
