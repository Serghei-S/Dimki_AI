        "thresholdSeconds",
        "distanceUnit",
        "timeUnit",
        "costUnit",
        "costPriceYear",
        "costsAreSynthetic",
        "edgeTimeRule",
        "aggregationRule",
        "coverageRule",
        "comparisonEpsilonSeconds"
