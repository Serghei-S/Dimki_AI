{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:obninsk2040:district:1.0.0",
  "title": "Fictional district data contract v1",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "generatedForDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "synthetic": {
          "const": true
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "enum": [
            "UNLICENSED",
            "ODbL-1.0"
          ]
        },
        "coordinateSystem": {
          "type": "object",
          "properties": {
            "id": {
              "const": "LOCAL_METERS"
            },
            "axes": {
              "const": [
                "east",
                "north"
              ]
            },
            "units": {
              "const": "m"
            },
            "displayOriginWgs84": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "earthRadiusM": {
              "type": "number",
              "minimum": 6000000,
              "maximum": 7000000
            },
            "displayTransform": {
              "type": "string",
              "minLength": 1
            },
            "accuracy": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "axes",
            "units",
            "displayOriginWgs84",
            "earthRadiusM",
            "displayTransform",
            "accuracy"
          ],
          "additionalProperties": false
        },
        "boundsM": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "schemaVersion",
        "datasetVersion",
        "seed",
        "generatedForDate",
        "synthetic",
        "source",
        "license",
        "coordinateSystem",
        "boundsM",
        "limitations"
      ],
      "additionalProperties": false
    },
    "metricDefinitions": {
      "type": "object",
      "properties": {
        "thresholdSeconds": {
          "type": "object",
          "properties": {
            "bus_stop": {
              "type": "number",
              "minimum": 1
            },
            "park": {
              "type": "number",
              "minimum": 1
            },
            "school": {
              "type": "number",
              "minimum": 1
            },
            "clinic": {
              "type": "number",
              "minimum": 1
            },
            "grocery": {
              "type": "number",
              "minimum": 1
            }
          },
          "required": [
            "bus_stop",
            "park",
            "school",
            "clinic",
            "grocery"
          ],
          "additionalProperties": false
        },
        "distanceUnit": {
          "const": "m"
        },
        "timeUnit": {
          "const": "s"
        },
        "costUnit": {
          "const": "RUB"
        },
        "costPriceYear": {
          "type": "integer",
          "minimum": 2020,
          "maximum": 2100
