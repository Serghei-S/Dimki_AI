# Copy to .env.local. Keys stay on the local Node server; never use a VITE_ prefix.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=

# For the prepaid RiskRadar API set AI_PROVIDER=riskradar and enter its own API key.
# A VIBE-... promo code is not an API key. OpenRouter credentials are never reused here.
RISKRADAR_API_KEY=
RISKRADAR_MODEL=gemini-2.5-flash
